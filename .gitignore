# Python / Flask backend
backend/venv/
__pycache__/
*.pyc
backend/instance/
.pytest_cache/

# Env files -- real secrets and DB URLs never get committed; .env.example does
.env
.env.*.local

# Trained classifiers -- generated by scripts/train_grader.py, rerun it after cloning
backend/ml_models/*.joblib

# Node / React frontend
node_modules/
dist/

# OS / editor cruft
.DS_Store
*.log

# Benchmark data (ASAP-AES): licensed dataset, never committed
backend/data/

# Fine-tuning experiment outputs: weights and checkpoints, never committed
backend/ml_experiments/

# Model weights, wherever they land (the fine-tuned DistilBERT is 269 MB).
# backend/ml_experiments/ is where they belong; these are the backstop.
*.safetensors
best_model/
